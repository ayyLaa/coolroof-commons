# Read by docker compose. Copy to .env; scripts/start.sh does that and fills the key.

# Signs evidence hashes (device_signature). Required; start.sh generates a fresh one.
DEVICE_PRIVATE_KEY=

# Local mode binds Docker ports to loopback. Remote mode requires separate write/event keys.
APP_MODE=local
POSTGRES_HOST_PORT=5432
WRITE_API_KEY=
EVENT_API_KEY=
# For docker-compose.amoy.yml, also configure AMOY_RPC_URL, EVENTS_FROM_BLOCK and the
# deployment/party variables below. Keep keys in local .env files, never in the frontend build.

# Everything below is optional. Unset, the stack runs on its own local Hardhat chain.
# To use Amoy instead, deploy there (contracts/README.md) and set:
# AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# EVENTS_FROM_BLOCK=
# CHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# CONTRACT_ADDRESS=
# CONTRACT_SPONSOR=
# CONTRACT_CONTRACTOR=
# ORACLE_PRIVATE_KEY=
# EXPLORER_URL=https://amoy.polygonscan.com
