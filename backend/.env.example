# Copy to backend/.env and adjust. backend/.env is git-ignored.

DATABASE_URL=postgresql+psycopg2://coolroof:coolroof@localhost:5432/coolroof
CORS_ORIGINS=http://localhost:5173

# Private key that signs evidence hashes (device_signature). Generate one with the
# backend's own interpreter (eth_account is installed there, not in the system Python):
#   Windows:     .venv\Scripts\python -c "from eth_account import Account; print('0x' + Account.create().key.hex().removeprefix('0x'))"
#   macOS/Linux: .venv/bin/python -c "from eth_account import Account; print('0x' + Account.create().key.hex().removeprefix('0x'))"
# Never commit a real key; the contract must know the matching address.
DEVICE_PRIVATE_KEY=

# Base URL used to build mask_preview_url links to coverage overlays.
PUBLIC_BASE_URL=http://localhost:8000
# Where uploaded roof photos and their overlays are stored (default: <repo>/data/photos).
# PHOTO_DIR=

# Solar reflectance assumed for coated roofs, since after-coating albedo is not measured.
ASSUMED_COATED_ALBEDO=0.75

# Installed coating price per square metre; estimated_cost_eur = area_m2 x this.
COST_PER_M2_EUR=12

# Escrow deployment shown on GET /contracts/{roof_id}; leave empty until deployed
# (the API then returns null). Sponsor and contractor are the accounts
# contracts/scripts/setup-demo.ts creates the demo projects with.
CONTRACT_ADDRESS=
CONTRACT_SPONSOR=
CONTRACT_CONTRACTOR=
# Deposit per project in wei (setup-demo.ts locks 0.001 native token).
CONTRACT_DEPOSIT_WEI=1000000000000000

# Google Cloud project with the Earth Engine API enabled. Only scripts/fetch_satellite.py
# needs it (it reads backend/.env through app.core.config); --project overrides it.
EE_PROJECT=
