PRIVATE_KEY=
# WARNING: if this RPC points at Amoy (or any chain but a local one), transactions spend
# real POL from the wallets below. They are refused unless ALLOW_MAINNET_SPEND=true.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Set to true only on purpose: lets deploy and setup-demo send transactions off a local
# chain. scripts/demo-round.sh amoy sets it itself, after AMOY is typed.
ALLOW_MAINNET_SPEND=
POLYGONSCAN_API_KEY=
ORACLE_ADDRESS=
# Key of ORACLE_ADDRESS; setup-demo uses it once to pay ATH-0355's quality tranche.
ORACLE_PRIVATE_KEY=
CONTRACTOR_ADDRESS=
