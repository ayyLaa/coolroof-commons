# The FastAPI backend (uvicorn's default port).
BACKEND_URL=http://localhost:8000
# WARNING: if this RPC points at Amoy (or any chain but a local one), transactions spend
# real POL from the wallets below. They are refused unless ALLOW_MAINNET_SPEND=true.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Set to true only on purpose: lets the oracle submit verifications off a local chain.
ALLOW_MAINNET_SPEND=
ORACLE_PRIVATE_KEY=
CONTRACT_ADDRESS=
# HTTP server for the demo panel (npm run serve).
ORACLE_PORT=4020
ORACLE_CORS_ORIGIN=http://localhost:5173
# First block the listener replays on startup (default 0, a local chain). On Amoy, the
# escrow's deployment block, so the replay stays short.
EVENTS_FROM_BLOCK=
