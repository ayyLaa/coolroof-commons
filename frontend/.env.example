# The FastAPI backend (uvicorn). Use http://localhost:4010 for the Prism mock (npm run mock).
VITE_API_URL=http://localhost:8000
# The oracle's HTTP server (cd oracle; npm run serve).
VITE_ORACLE_URL=http://localhost:4020
# Optional: enable the independent read-only chain check. No wallet or private key.
# If this points at Amoy, the demo panel is driving a chain where every oracle
# submission spends real POL; the header badge shows the oracle's chain.
VITE_AMOY_RPC_URL=
# Chain the check expects: 80002 for Amoy (default), 31337 for a local Hardhat node.
VITE_CHAIN_ID=
# Block explorer for transaction links (default https://amoy.polygonscan.com).
VITE_EXPLORER_URL=
# Optional: pin the deployed escrow address instead of using the backend address.
VITE_CONTRACT_ADDRESS=
