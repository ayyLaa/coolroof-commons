{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "gen:types": "openapi-typescript ../openapi.yaml -o src/api/schema.d.ts",
    "preview": "vite preview",
    "mock": "prism mock ../openapi.yaml -p 4010",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@mantine/charts": "^9.7.3",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "ethers": "^6.17.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
